# ============================================================================
# DEALS HUNTER - CONFIGURAÇÃO (.env)
# ============================================================================

# 1. NOTIFICAÇÕES DIRETO NO PC (Ativado por padrão — funciona sem Telegram!)
DESKTOP_NOTIFICATIONS=true
AUTO_OPEN_BROWSER=false

# 2. INTEGRAÇÃO OPCIONAL COM TELEGRAM (@BotFather)
# Deixe em branco se quiser receber alertas apenas no PC.
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=

# 3. BANCO DE DADOS E INTERVALO DE VARREDURA
DB_PATH=watcher.db
SCRAPE_INTERVAL_MIN_MINUTES=10
SCRAPE_INTERVAL_MAX_MINUTES=15
HTTP_TIMEOUT_SECONDS=15
